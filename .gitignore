# 依赖与构建产物
node_modules/
dist/
app/node_modules/
app/dist/
.worktrees/
.superpowers/
# 0927 P2-7：pnpm 锁文件不与 npm 双轨跟踪（仓库以 app/package-lock.json 为准，pnpm 安装产物不入库）
app/pnpm-lock.yaml

# 本地设计资料（仅本地保留，不入库 / 不推送）
设计稿/
# 旧平台源码，开发时逐字段核对用的参考件，不是本仓库的产物
旧平台代码/
.ris-shots/
.env
tmp/
.pnpm-store/
__pycache__/
*.pyc
backend/
# 服务器 SSH 密码脚本与 known_hosts 缓存（含凭据，绝不入库）
tmp/askpass-*
tmp/known_hosts_*
# 本地临时查询/排查脚本（数据库验证等，不入库）
tmp/*.java
# 测试运行的输出日志（vitest 等，2026-10-20 曾有 *.out 被误提交）
tmp/*.out
# 视觉工具运行目录（本地产物）
.dsh-vision-router/
# 本地粘贴的截图（不入库）
Pasted image *.png
# Runner 管理服务生成的独立站点脚本 Git 仓库
site-scripts/
# Runner 运行日志及上传分片
runner-logs/
# 本地服务运行日志（2026-10-26 曾有 logs/info/*.log.gz 被误提交）
logs/