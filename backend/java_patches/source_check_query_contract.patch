+    /** 把 AI 检查交给本机执行器（`/monitor-runner/scan`），失败时返回 ok=false 与原因。 */
+    private Map<String, Object> invokeRunnerScan(List<Integer> ids, boolean apply) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        String url = runnerBaseUrl.replaceAll("/+$", "") + "/monitor-runner/scan";
+        HttpURLConnection conn = null;
