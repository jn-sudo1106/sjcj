+            conn.setConnectTimeout(3000);
+            conn.setReadTimeout(120000);
+            conn.setDoOutput(true);
+            conn.setRequestProperty("Content-Type", "application/json;charset=UTF-8");
+            conn.setRequestProperty("Access-Token", runnerToken);
+            try (OutputStream os = conn.getOutputStream()) {
+                os.write(bytes);
+            }
+            int status = conn.getResponseCode();
+            java.io.InputStream is = status >= 200 && status < 300 ? conn.getInputStream() : conn.getErrorStream();
+            StringBuilder sb = new StringBuilder();
+            if (is != null) {
+                try (BufferedReader reader = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
+                    String line;
+                    while ((line = reader.readLine()) != null) sb.append(line);
+                }
+            }
+            if (status < 200 || status >= 300) {
+                result.put("ok", false);
+                result.put("message", "执行器返回 HTTP " + status + "：" + sb);
+                return result;
+            }
+            Map<String, Object> parsed = parseJsonObject(sb.toString());
+            result.put("ok", parsed != null);
+            result.put("items", parsed == null ? null : parsed.get("items"));
+            result.put("count", parsed == null ? null : parsed.get("count"));
+            result.put("message", parsed == null ? "执行器返回无法解析：" + sb : "执行器已返回结果");
+            return result;
+        } catch (Exception e) {
+            log.error("调用监控执行器失败: {}", url, e);
+            result.put("ok", false);
+            result.put("message", "调用监控执行器失败：" + e.getMessage());
+            return result;
+        } finally {
+            if (conn != null) conn.disconnect();
+        }
+    }
