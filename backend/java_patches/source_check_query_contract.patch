     /**
+     * C07 执行结论：按源汇总「启用中检查项最近一次运行」的结果。
+     *
+     * 失败优先（任一启用项最近一次是 E → failed），全部有结果且无失败 → succeeded；
+     * 一条都没跑过 → unknown（不能默认成功）。停用的检查项不参与，避免一条历史失败记录把整源长期标红。
+     */
+    public Map<Long, String> execStateForSources(List<Long> sourceIds) {
+        Map<Long, String> result = new HashMap<>();
+        if (sourceIds == null || sourceIds.isEmpty()) return result;
+        QueryWrapper<CkSource> qw = new QueryWrapper<>();
+        qw.in("SOURCE_ID", sourceIds);
+        qw.eq("IS_DELETE", 0);
+        List<CkSource> monitors = ckSourceMapper.selectList(qw);
+        List<Integer> ids = new ArrayList<>();
+        for (CkSource m : monitors) {
+            if (m.getId() != null) ids.add(m.getId());
+        }
+        Map<Integer, String> latest = new HashMap<>();
+        if (!ids.isEmpty()) {
+            for (Map<String, Object> row : ckSourceMapper.selectLatestLogState(ids)) {
+                Object jobId = row.get("jobId");
+                if (jobId == null) continue;
+                Object state = row.get("state");
+                latest.put((int) toLongStatic(jobId), state == null ? null : String.valueOf(state));
+            }
+        }
+        for (CkSource m : monitors) {
+            if (m.getSourceId() == null) continue;
+            String current = result.get(m.getSourceId());
+            String state = latest.get(m.getId());
+            if (state == null) {
+                if (current == null) result.put(m.getSourceId(), "unknown");
+            } else if ("E".equals(state)) {
+                result.put(m.getSourceId(), "failed");
+            } else if (!"failed".equals(current)) {
+                result.put(m.getSourceId(), "succeeded");
+            }
+        }
+        return result;
