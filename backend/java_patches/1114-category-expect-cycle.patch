+    /** 预期更新周期的上限：366 天，防止把「小时」当「天」填出天文数字 */
+    private static final int MAX_EXPECT_CYCLE_HOURS = 24 * 366;
+
+    /** 业务目录根（cfg_category 里「业务目录」这棵树的根） */
+    private static final int BIZ_ROOT_ID = -2;
+
+    /** 「我的视图」根，挂在业务目录下面也不允许设周期 */
+    private static final int VIEW_ROOT_ID = -1;
+
+    /**
+     * 设置业务目录的预期更新周期（小时）；显式传 0 = 清空。
+     *
+     * <p>必须是独立端点、不能塞进 /update：上面那个是 form 绑定（CfgCategory 参数），
+     * 没传的字段一律是 null，无法区分「没传」和「传 0」——而改分类名、调 seq 都会走 /update，
+     * 一旦在那里处理周期，改个名字就会把周期清掉。
+     *
+     * <p>参数用 String 接收再手工解析，图两件事：① 「没传 / 空串」能与「传 0」区分开，
+     * 缺参直接报错而不是悄悄清空；② 1.5、abc 这类输入返回业务提示，不落到 Spring 类型转换的 500。
+     */
+    @RequestMapping(value = "/updateExpectCycle", method = RequestMethod.POST)
+    @ResponseBody
+    public RspResult updateExpectCycle(
+            @RequestParam(value = "categoryId", required = false) Integer categoryId,
+            @RequestParam(value = "expectCycleHours", required = false) String expectCycleHours) {
+        if (categoryId == null || categoryId == 0) {
+            return RspResult.getFailtResult("categoryId 不能为空");
+        }
+        if (categoryId == BIZ_ROOT_ID) {
+            return RspResult.getFailtResult("业务目录根节点不能设置预期周期，请在具体目录上设置");
+        }
+        if (categoryId < 0) {
+            return RspResult.getFailtResult("视图目录不能设置预期周期");
+        }
+        // 必填：不传或空串都按参数错误处理，避免调用方漏参数时把已有周期悄悄清掉；清空必须显式传 0
+        if (expectCycleHours == null || expectCycleHours.trim().isEmpty()) {
+            return RspResult.getFailtResult("expectCycleHours 必填，清空请传 0");
+        }
+        int hours;
+        try {
+            hours = Integer.parseInt(expectCycleHours.trim());
+        } catch (NumberFormatException e) {
+            return RspResult.getFailtResult("预期周期必须是整数小时");
+        }
+        if (hours < 0) {
+            return RspResult.getFailtResult("预期周期不能为负数");
+        }
+        if (hours > MAX_EXPECT_CYCLE_HOURS) {
+            return RspResult.getFailtResult("预期周期不能超过 " + MAX_EXPECT_CYCLE_HOURS + " 小时");
+        }
+        CfgCategory category = categoryService.queryCategoryById(categoryId);
+        if (category == null || category.getIsDelete() == null
+                || category.getIsDelete() != DeleteEnum.ENABLE.val()) {
+            return RspResult.getFailtResult("目录不存在或已删除");
+        }
+        if (!isBizCategory(category)) {
+            return RspResult.getFailtResult("只有业务目录（根 -2 下）可以设置预期周期");
+        }
+        // 只有显式 0 才清空；库里只存 NULL，避免「0 小时」参与停更判定
+        Integer stored = hours == 0 ? null : hours;
+        log.info("updateExpectCycle: categoryId={}, hours={}", categoryId, stored);
+        categoryService.updateExpectCycleHours(categoryId, stored);
+        return RspResult.getSuccessResult();
+    }
+
+    /**
+     * 是否是「业务目录根 -2」子树下的目录。
+     *
+     * <p>按 parentId 链向上找 -2；遇到 0 / -1（视图根）立即判否，防止视图目录挂到业务目录下被误判。
+     * 不用 PATH 前缀判定：存量 PATH 格式不一致（-2 是 "0,"，孙级是 "0,9006333,9006442," 不带 -2）。
+     */
+    private boolean isBizCategory(CfgCategory category) {
+        Integer id = category.getCategoryId();
+        if (id != null && id == BIZ_ROOT_ID) {
+            // 根本身不是可设置周期的目录
+            return false;
+        }
+        Set<Integer> visited = new HashSet<>();
+        CfgCategory cur = category;
+        while (cur != null && cur.getCategoryId() != null && visited.add(cur.getCategoryId())) {
+            Integer parentId = cur.getParentId();
+            if (parentId == null || parentId == 0 || parentId == VIEW_ROOT_ID) {
+                return false;
+            }
+            if (parentId == BIZ_ROOT_ID) {
+                return true;
+            }
+            cur = categoryService.queryCategoryById(parentId);
+        }
+        return false;
+    }
+
