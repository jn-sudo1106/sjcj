+    /**
+     * 批量查询多个源的步骤详情（源产出监控全目录计数用）。
+     *
+     * <p>每个源的结果与 {@link #queryStepDetail(Long)} 一致；统计仍走 {@link #_fillDataCount} 的
+     * 2 分钟 dataCache，所以同一批里重复源、以及与单源接口的交叉调用都能命中缓存。
+     * 请求是同步串行的：500 源 × 每源若干输出表，首次冷启动会偏慢，前端按 100~200 一批分批调用即可。
+     */
+    @RequestMapping(value = {"/queryStepDetailBatch"}, method = RequestMethod.POST)
+    @ResponseBody
+    public RspResult queryStepDetailBatch(@RequestBody SourceStepDetailReq req) {
+        List<Long> ids = req == null ? null : req.getSourceIds();
+        if (ids == null || ids.isEmpty()) {
+            return RspResult.getFailtResult("sourceIds 不能为空");
+        }
+        Set<Long> uniq = new LinkedHashSet<>();
+        for (Long id : ids) {
+            if (id != null && id > 0) {
+                uniq.add(id);
+            }
+        }
+        if (uniq.isEmpty()) {
+            return RspResult.getFailtResult("sourceIds 不能为空");
+        }
+        if (uniq.size() > MAX_BATCH_SOURCES) {
+            return RspResult.getFailtResult("单次最多查询 " + MAX_BATCH_SOURCES + " 个源，请分批调用");
+        }
+        Map<String, List<StepInfo>> data = new LinkedHashMap<>();
+        for (Long id : uniq) {
+            Source source = sourceCache.getFromDb(id);
+            List<StepInfo> steps = (source == null || source.getDefaultFlowId() == null)
+                    ? new ArrayList<>() : buildStepDetails(source);
+            data.put(String.valueOf(id), steps);
+        }
+        return RspResult.getSuccessResult().setData(data);
+    }
+
+    /** 单次批量查询的源数量上限（前端分批调用，避免一次请求把线程占满） */
+    private static final int MAX_BATCH_SOURCES = 500;
+
+    /**
+     * 按源拼装步骤详情（含输出表统计）；queryStepDetail 与批量接口共用。
+     *
+     * <p>调用方需保证 source 非空且 defaultFlowId 非空。
+     */
